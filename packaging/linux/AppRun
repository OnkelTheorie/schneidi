#!/bin/sh
# AppImage entry: the app, or schneidi-cli for `schneidi.AppImage cli …` and for a link named schneidi-cli
# (the AppImage runtime passes the called name in ARGV0). linuxdeploy runs its hooks (Qt paths) before this script.
HERE="$(dirname "$(readlink -f "$0")")"

# Qt needs libEGL/libOpenGL (libglvnd), which servers without a desktop often lack. Use the bundled copy of a
# library only when the system has none, so desktops keep the one that matches their GPU driver.
has_lib() {
    for d in /lib /usr/lib /lib64 /usr/lib64 /lib/x86_64-linux-gnu /usr/lib/x86_64-linux-gnu; do
        [ -e "$d/$1" ] && return 0
    done
    { ldconfig -p 2>/dev/null || /sbin/ldconfig -p 2>/dev/null; } | grep -q "^[[:space:]]*$1 "
}
for lib in libEGL.so.1 libOpenGL.so.0 libGLdispatch.so.0; do
    dir="$HERE/usr/lib/fallback/${lib%%.so*}"
    if [ -d "$dir" ] && ! has_lib "$lib"; then
        LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$dir"
    fi
done
export LD_LIBRARY_PATH

# The bundled libva looks for the VAAPI drivers only where Debian keeps them; other distributions keep them in
# lib64/ or lib/ (Fedora, openSUSE, Arch): without this hardware decoding and encoding are gone there
if [ -z "$LIBVA_DRIVERS_PATH" ]; then
    for d in /usr/lib/x86_64-linux-gnu/dri /usr/lib64/dri /usr/lib/dri; do
        [ -d "$d" ] && LIBVA_DRIVERS_PATH="${LIBVA_DRIVERS_PATH:+$LIBVA_DRIVERS_PATH:}$d"
    done
    [ -n "$LIBVA_DRIVERS_PATH" ] && export LIBVA_DRIVERS_PATH
fi

if [ "$1" = "cli" ]; then
    shift
    exec "$HERE/usr/bin/schneidi-cli" "$@"
fi
case "$(basename "${ARGV0:-$0}")" in
    schneidi-cli*) exec "$HERE/usr/bin/schneidi-cli" "$@" ;;
esac
exec "$HERE/usr/bin/schneidi" "$@"
