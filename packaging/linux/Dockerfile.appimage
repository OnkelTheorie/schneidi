# Build environment of the Linux AppImage: Ubuntu 22.04 (glibc 2.35, libstdc++ GLIBCXX_3.4.30), the oldest LTS in
# standard support, so the package runs there and on everything newer (the AppImage catalog tests on that one).
# Everything the AppImage bundles comes from 22.04's packages or is built here: GCC 12 (its libstdc++ is the one
# 22.04 ships, no newer GLIBCXX), Qt 6.8 LTS from the Qt online archives (aqtinstall; 22.04's Qt 6.2 is too old),
# FFmpeg by build-ffmpeg-lgpl.sh against 22.04's x264/x265.
#   packaging/linux/build-appimage-docker.sh   (builds this image and runs build-appimage.sh in it)
FROM ubuntu:22.04
ARG QT_VERSION=6.8.3
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        gcc-12 g++-12 make cmake ninja-build pkg-config git ca-certificates curl xz-utils file binutils \
        python3 python3-pip python3-venv patchelf desktop-file-utils \
        zlib1g-dev libbz2-dev liblzma-dev \
        nasm libopenh264-dev libsvtav1enc-dev libvpx-dev libdav1d-dev \
        libopus-dev libmp3lame-dev libva-dev libdrm-dev libvpl-dev \
        libx264-dev libx265-dev \
        libgl-dev libegl-dev libopengl-dev libglvnd-dev libvulkan-dev libfontconfig1-dev libfreetype-dev \
        libxkbcommon-dev libxkbcommon-x11-0 libwayland-dev libwayland-egl1 libwayland-cursor0 libdbus-1-3 \
        libx11-xcb1 libxcb1 libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 \
        libxcb-render-util0 libxcb-shape0 libxcb-shm0 libxcb-sync1 libxcb-xfixes0 libxcb-xinerama0 libxcb-xkb1 \
        libxcb-glx0 libxcb-xinput0 libpulse0 libasound2 \
 && rm -rf /var/lib/apt/lists/* \
 && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 100 \
 && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-12 100 \
 && update-alternatives --install /usr/bin/cc cc /usr/bin/gcc-12 100 \
 && update-alternatives --install /usr/bin/c++ c++ /usr/bin/g++-12 100
# kvazaar (BSD-3, the H.265 encoder of the GPL-free build and the fallback without x265): no 22.04 package
ARG KVAZAAR_VERSION=2.3.1
RUN git clone --depth 1 --branch "v$KVAZAAR_VERSION" https://github.com/ultravideo/kvazaar.git /tmp/kvazaar \
 && cmake -S /tmp/kvazaar -B /tmp/kvazaar/build -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON \
        -DBUILD_TESTS=OFF -DCMAKE_INSTALL_PREFIX=/usr/local \
 && cmake --build /tmp/kvazaar/build && cmake --install /tmp/kvazaar/build && ldconfig && rm -rf /tmp/kvazaar
# Qt (with private headers; qtwayland and qtsvg are part of the base archives) under /opt/qt
RUN python3 -m venv /opt/aqt \
 && /opt/aqt/bin/pip install --no-cache-dir aqtinstall \
 && /opt/aqt/bin/aqt install-qt linux desktop "$QT_VERSION" linux_gcc_64 -O /opt/qt \
 && rm -rf /opt/qt/*/gcc_64/doc /opt/qt/*/gcc_64/examples
ENV QT_DIR=/opt/qt/${QT_VERSION}/gcc_64
ENV PATH=/opt/qt/${QT_VERSION}/gcc_64/bin:$PATH \
    CMAKE_PREFIX_PATH=/opt/qt/${QT_VERSION}/gcc_64 \
    QMAKE=/opt/qt/${QT_VERSION}/gcc_64/bin/qmake \
    LD_LIBRARY_PATH=/opt/qt/${QT_VERSION}/gcc_64/lib \
    CC=gcc-12 CXX=g++-12
